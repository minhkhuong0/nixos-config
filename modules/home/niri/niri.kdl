// Automatically generated by home-manager from `wayland.windowManager.niri`
binds {
	Print {
		screenshot
	}
	Alt+Print {
		screenshot-window
	}
	Ctrl+Print {
		screenshot-screen
	}
	Mod+0 {
		focus-workspace "w9"
	}
	Mod+1 {
		focus-workspace "w0"
	}
	Mod+2 {
		focus-workspace "w1"
	}
	Mod+3 {
		focus-workspace "w2"
	}
	Mod+4 {
		focus-workspace "w3"
	}
	Mod+5 {
		focus-workspace "w4"
	}
	Mod+6 {
		focus-workspace "w5"
	}
	Mod+7 {
		focus-workspace "w6"
	}
	Mod+8 {
		focus-workspace "w7"
	}
	Mod+9 {
		focus-workspace "w8"
	}
	Mod+B {
		spawn "/nix/store/sakwwfknad7adibsvs65dsnjfn34m5yw-firefox-156.0/bin/firefox"
	}
	Mod+C {
		center-column
	}
	Mod+Ctrl+H {
		set-column-width "-5%"
	}
	Mod+Ctrl+J {
		set-window-height "-5%"
	}
	Mod+Ctrl+K {
		set-window-height "+5%"
	}
	Mod+Ctrl+L {
		set-column-width "+5%"
	}
	Mod+Ctrl+WheelScrollDown {
		focus-workspace-down
	}
	Mod+Ctrl+WheelScrollUp {
		focus-workspace-up
	}
	Mod+Down {
		focus-window-down
	}
	Mod+F {
		maximize-column
	}
	Mod+G {
		fullscreen-window
	}
	Mod+H {
		focus-column-left
	}
	Mod+J {
		focus-window-down
	}
	Mod+K {
		focus-window-up
	}
	Mod+L {
		focus-column-right
	}
	Mod+Left {
		focus-column-left
	}
	Mod+Q {
		close-window
	}
	Mod+Right {
		focus-column-right
	}
	Mod+Shift+0 {
		move-column-to-workspace "w9"
	}
	Mod+Shift+1 {
		move-column-to-workspace "w0"
	}
	Mod+Shift+2 {
		move-column-to-workspace "w1"
	}
	Mod+Shift+3 {
		move-column-to-workspace "w2"
	}
	Mod+Shift+4 {
		move-column-to-workspace "w3"
	}
	Mod+Shift+5 {
		move-column-to-workspace "w4"
	}
	Mod+Shift+6 {
		move-column-to-workspace "w5"
	}
	Mod+Shift+7 {
		move-column-to-workspace "w6"
	}
	Mod+Shift+8 {
		move-column-to-workspace "w7"
	}
	Mod+Shift+9 {
		move-column-to-workspace "w8"
	}
	Mod+Shift+F {
		toggle-window-floating
	}
	Mod+Shift+H {
		move-column-left
	}
	Mod+Shift+J {
		move-window-down
	}
	Mod+Shift+K {
		move-window-up
	}
	Mod+Shift+L {
		move-column-right
	}
	Mod+T {	spawn-sh "footclient";	}
  Mod+D { spawn-sh "noctalia msg panel-toggle launcher"; }
	Mod+Up {
		focus-window-up
	}
	Mod+WheelScrollDown {
		focus-column-left
	}
	Mod+WheelScrollUp {
		focus-column-right
	}
	XF86AudioLowerVolume {
		spawn-sh "wpctl set-volume -l 1.4 @DEFAULT_AUDIO_SINK@ 5%-"
	}
	XF86AudioMicMute {
		spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
	}
	XF86AudioMute {
		spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
	}
	XF86AudioRaiseVolume {
		spawn-sh "wpctl set-volume -l 1.4 @DEFAULT_AUDIO_SINK@ 5%+"
	}
	XF86MonBrightnessDown {
		spawn-sh "brightnessctl --class=backlight set 10%-"
	}
	XF86MonBrightnessUp {
		spawn-sh "brightnessctl --class=backlight set +10%"
	}
}
input {
	keyboard {
		xkb {
			layout "de"
			variant "us"
		}
	}
	touchpad {
		dwt
		middle-emulation
		natural-scroll
		scroll-method "two-finger"
		tap
	}
}
layout {
	gaps 8
}
prefer-no-csd true
spawn-sh-at-startup "export XDG_CONFIG_HOME = $HOME/.config"
xwayland-satellite {
	path "/nix/store/fpdq16qwldlsp0mhlg2wi2gvwgb8x9i9-xwayland-satellite-0.8.2/bin/xwayland-satellite"
}

include "noctalia.kdl"
